# Release signing template - copy to android/keystore.properties (git-ignored)
# and fill in. Generate the upload key ONCE and keep it safe (Play App Signing
# can reset a lost upload key, but only through Play Console support):
#
#   keytool -genkeypair -v -keystore stak-upload.jks -alias stak -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/ (an absolute path also works).
# CI can export STAK_KEYSTORE_FILE / STAK_KEYSTORE_PASSWORD / STAK_KEY_ALIAS /
# STAK_KEY_PASSWORD instead of shipping this file.
storeFile=stak-upload.jks
storePassword=
keyAlias=stak
keyPassword=
