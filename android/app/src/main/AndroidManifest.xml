<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 08 Permissions "Allow and continue" asks for this on Android 13+ (product audit, 2026-09-05). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:name=".StakApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.STAK">
        <!-- Android 16 (target 36) ignores the portrait lock on tablets and unfolded foldables (smallest width 600dp+),
             so STAK would turn sideways there and stretch the phone layout across the screen (PhoneColumn only
             columns an upright window). This keeps it upright, in its column, until the large-screen layout exists -
             and keeps the fullscreen news video's requestedOrientation calls working there (NewsDetailScreen).
             Targeting 37 (expected to be required for Play updates from 2027-08) removes this opt-out.
             enableOnBackInvokedCallback="false" above keeps back as it was at target 35 too: 36 turns predictive back on,
             which would drive the page transitions (StakNavHost) with the back swipe - its own change, once tested.
             BackHandler works either way. -->

        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/Theme.STAK">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".StakMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="stak_alerts" />
        <!-- Hands the share picture (cache/share/) to the app the person shares it to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
