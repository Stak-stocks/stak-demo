<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose-only app: framework base theme, branded window/system-bar colors. -->
    <style name="Theme.STAK" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A1020</item>
        <item name="android:statusBarColor">#0A1020</item>
        <item name="android:navigationBarColor">#10172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 8-11: no preview window, so the first thing drawn is the app's own 00 Splash
             (PreSplashView). Android 12+ ignores this flag for launcher taps; values-v31 uses a
             translucent window instead. -->
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
