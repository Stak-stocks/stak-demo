<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ rules. The session (stak_session), every per-account state record
   (stak_state) and the copied avatars are phone-local by promise (Codex
   review, PR #166) - excluded from cloud backup and device transfer alike.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="stak_session.xml"/>
        <exclude domain="sharedpref" path="stak_state.xml"/>
        <exclude domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stak_session.xml"/>
        <exclude domain="sharedpref" path="stak_state.xml"/>
        <exclude domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
