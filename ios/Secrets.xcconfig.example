// Copy to Secrets.xcconfig (gitignored), or run scripts/pull-secrets.sh to fetch the real one from Secret Manager.
// The values are built into the app; users never need this file. See SECRETS.md.
// xcconfig treats `//` as a comment, so SUPABASE_URL is the host only (no https://).

SUPABASE_URL = your-project-ref.supabase.co
SUPABASE_ANON_KEY =
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
